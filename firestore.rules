rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validShortText(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "bio",
          "favoriteGame",
          "avatarSeed",
          "isAnonymous",
          "photoURL",
          "photoPath",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && validShortText(request.resource.data.displayName, 42);
    }

    match /communityRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validShortText(request.resource.data.text, 900)
        && validShortText(request.resource.data.authorName, 42);
    }

    match /forumTopics/{topicId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validShortText(request.resource.data.title, 90)
        && validShortText(request.resource.data.subject, 40)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 260;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessageAt", "messageCount"]);

      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validShortText(request.resource.data.text, 900)
          && validShortText(request.resource.data.authorName, 42);
      }
    }
  }
}
