rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validShortText(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function validOptionalText(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "bio",
          "favoriteGame",
          "avatarSeed",
          "isAnonymous",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && validShortText(request.resource.data.displayName, 42);
    }

    match /communityRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "text",
          "authorId",
          "authorName",
          "authorRole",
          "authorPhotoURL",
          "createdAt"
        ])
        && request.resource.data.authorId == request.auth.uid
        && validShortText(request.resource.data.text, 900)
        && validShortText(request.resource.data.authorName, 42);
    }

    match /directChats/{chatId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "participants",
          "participantNames",
          "participantPhotos",
          "lastMessage",
          "lastSender",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && validOptionalText(request.resource.data.lastMessage, 900);
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "participantNames",
          "participantPhotos",
          "lastMessage",
          "lastSender",
          "updatedAt",
          "createdAt"
        ]);

      match /messages/{messageId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/directChats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/directChats/$(chatId)).data.participants.hasAny([request.auth.uid])
          && request.resource.data.keys().hasOnly([
            "text",
            "authorId",
            "authorName",
            "authorRole",
            "authorPhotoURL",
            "targetId",
            "targetName",
            "createdAt"
          ])
          && request.resource.data.authorId == request.auth.uid
          && validShortText(request.resource.data.text, 900)
          && validShortText(request.resource.data.authorName, 42);
      }
    }

    match /communityFeed/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "type",
          "title",
          "subject",
          "body",
          "createdBy",
          "createdByName",
          "createdByPhotoURL",
          "commentCount",
          "createdAt",
          "lastActivityAt"
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ["post", "article"]
        && validOptionalText(request.resource.data.title, 120)
        && validShortText(request.resource.data.subject, 40)
        && validShortText(request.resource.data.body, 3000)
        && validShortText(request.resource.data.createdByName, 42)
        && request.resource.data.commentCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActivityAt", "commentCount"]);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            "text",
            "authorId",
            "authorName",
            "authorPhotoURL",
            "createdAt"
          ])
          && request.resource.data.authorId == request.auth.uid
          && validShortText(request.resource.data.text, 1200)
          && validShortText(request.resource.data.authorName, 42);
      }
    }

    match /forumTopics/{topicId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validShortText(request.resource.data.title, 90)
        && validShortText(request.resource.data.subject, 40)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 260;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessageAt", "messageCount"]);

      match /messages/{messageId} {
        allow read: if true;
        allow create: if false;
      }
    }
  }
}
